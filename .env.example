# Copie para .env e ajuste. Nunca envie o .env para o GitHub.

# Porta do servidor
PORT=3000

# "production" ativa cookies seguros (exige HTTPS)
NODE_ENV=production

# Usuário e senha do primeiro acesso ao painel (/admin).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e mostrada no terminal na primeira execução.
# Depois do primeiro acesso, troque a senha pelo painel (Configurações).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Pasta onde ficam o banco de dados, as fotos e os backups. Precisa ser um disco persistente.
DATA_DIR=./data

# Fuso horário usado nos relatórios
TIMEZONE=America/Sao_Paulo

# Quantos proxies reversos existem na frente do app (Caddy/nginx = 1). Necessário para o limite anti-abuso por IP.
TRUST_PROXY=1

# Cria o cardápio de exemplo na primeira execução (false para começar vazio)
SEED_DEMO_DATA=true
